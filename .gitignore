# Publish only the deliberately curated project tree. Keep all existing local
# games, research, reports and save data in place but outside Git.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/NOTICE.md
!/docs/
!/tools/
!/translations/
!/data/
!/assets/
!/patches/
!/tests/
!/.github/

# Never publish runtime inputs or generated content, even under allowed folders.
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.venv/
**/runtime/
**/build/
**/dist/
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.pfx
**/*.bin
**/*.iso
**/*.cue
**/*.chd
**/*.ccd
**/*.mds
**/*.mdf
**/*.rom
**/*.bios
**/*.dll
**/*.exe
**/*.srm
**/*.bcr
**/*.bkr
**/*.smpc
**/*.state
**/*.state.*
**/*.sav
**/*.log
**/*.zip
**/*.7z
**/Thumbs.db
**/.DS_Store
