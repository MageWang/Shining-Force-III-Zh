    "zh": "<00>未裝備<00>"
  },
  {
    "key": "f976298848195b28",
    "location": "X5BTL101.BIN:08:37",
    "zh": "<00>無法裝備<00>"
  },
  {
    "key": "8f2b1037c8b0e8bc",
    "location": "X5BTL101.BIN:08:38",
    "zh": "<00>卸下<00>"
  },
  {
    "key": "220a3207527f3766",
    "location": "X5BTL101.BIN:08:3B",
    "zh": "<00>種類不符！<00>"
  },
  {
    "key": "5c0ae1189991dcde",
    "location": "X5BTL101.BIN:08:3C",
    "zh": "<00>要讓 <12> 裝備 <14> 嗎？<1E><00>"
  },
  {
    "key": "98ce89430d97e3ad",
    "location": "X5BTL101.BIN:08:3E",
    "zh": "<00>轉職後<00>"
  },
  {
    "key": "bd151e265f7a20be",
    "location": "X5BTL101.BIN:08:40",
    "zh": "<00>無法卸下受詛咒的道具<02><00>"
  },
  {
    "key": "cff7a27b06c24689",
    "location": "X5BTL101.BIN:08:41",
    "zh": "<00><12> 找到了 <14><06><00>"
  },
  {
    "key": "5bffc1281a5e885d",
    "location": "X5BTL101.BIN:08:42",
    "zh": "<00>……已經拿太多了<06><00>"
  },
  {
    "key": "048e3767f95dad57",
    "location": "X5BTL101.BIN:08:43",
    "zh": "<00><12> 收下了 <14><06><00>"
  },
  {
    "key": "d14b2b8675d92a9c",
    "location": "X5BTL101.BIN:08:44",
    "zh": "<00>要丟掉什麼來換取 <14>？<1E><00>"
  },
  {
    "key": "d22acca974d92c35",
    "location": "X5BTL101.BIN:08:45",
    "zh": "<00>丟掉了 <14>，<03>拿起了 <14><06><00>"
  },
  {
    "key": "6f9381d42885ee8f",
    "location": "X5BTL101.BIN:08:46",
    "zh": "<00>放棄了 <14><06><00>"
  },
  {
    "key": "ec414159877e8832",
    "location": "X5BTL101.BIN:08:47",
    "zh": "<00>什麼也沒找到……<06><00>"
  },
  {
    "key": "df478643ecf9cfcd",
    "location": "X5BTL101.BIN:08:48",
    "zh": "<00><12> 打不開寶箱……<06><00>"
  },
  {
    "key": "64a78a29429ffc23",
    "location": "X5BTL101.BIN:08:4A",
    "zh": "<00><12> 收下了 <16> 枚金幣<1D><06><00>"
  },
  {
    "key": "1818b4907042db3d",
    "location": "X5BTL101.BIN:08:4B",
    "zh": "<00>要放棄 <14> 嗎？<1E><00>"
  },
  {
    "key": "990a2f71361bb2ba",
    "location": "X5BTL101.BIN:08:4C",
    "zh": "<00><12> 出現了！<06><00>"
  },
  {
    "key": "8f0e3fad17e99f50",
    "location": "X5BTL101.BIN:08:4D",
    "zh": "<00>要記錄進度嗎？<1E><00>"
  },
  {
    "key": "6cfa5392233ca226",
    "location": "X5BTL101.BIN:08:4E",
    "zh": "<00>要繼續冒險嗎？<1E><00>"
  },
  {
    "key": "2b156fcec4296eaf",
    "location": "X5BTL101.BIN:08:4F",
    "zh": "<00>地形<00>"
  },
  {
    "key": "9afe62843b9de04b",
    "location": "X5BTL101.BIN:08:50",
    "zh": "<00>看來 <11><15> 放棄了。<02><00>"
  },
  {
    "key": "405068ab46c0dd7a",
    "location": "X5BTL101.BIN:08:51",
    "zh": "<00>我們及時引爆了炸藥。<03>看來他已經<03>返回總部了。<02><00>"
  },
  {
    "key": "2c5e7cca2139e5b6",
    "location": "X5BTL101.BIN:08:52",
    "zh": "<00>那個戴面具的可疑<03>僧侶是怎麼回事！？<02><00>"
  },
  {
    "key": "9d28ac62fa23aefc",
    "location": "X5BTL101.BIN:08:53",
    "zh": "<00>你不是 <11><15> 和他的同夥。<03>你們是共和國的走狗！<02><00>"
  },
  {
    "key": "fdbda3a00c404ad1",
    "location": "X5BTL101.BIN:08:54",
    "zh": "<00>看來這些就是<03>王子 <11><15> 正在追捕的人。<02><00>"
  },
  {
    "key": "9eadf57a884267d0",
    "location": "X5BTL101.BIN:08:56",
    "zh": "<00>哈！就憑你們這群烏合之眾，<03>也想和我打？<03>我要把你們剁成碎片！<02><00>"
  },
  {
    "key": "5cf491aea803a264",
    "location": "X5BTL101.BIN:08:57",
    "zh": "<00>這些蒙面僧侶其實<03>根本是一群殺人犯……<02><00>"
  },
  {
    "key": "9fea2c012c186aef",
    "location": "X5BTL101.BIN:08:58",
    "zh": "<00>顯然是這些僧侶<03>炸毀了設施……<05>總之，<03>先回指揮中心吧。<02><00>"
  },
  {
    "key": "222c12d7ad29ab88",
    "location": "X5BTL101.BIN:08:59",
    "zh": "<00>敵人數量占優勢，<03>但只要策略得當，<03>我們就能打敗他們，<11><01>。<02><00>"
  },
  {
    "key": "cb0d5571f35fdd87",
    "location": "X5BTL101.BIN:08:5A",
    "zh": "<00>別得意忘形，<11><01>大人。<03>你們或許占上風，<03>但愚蠢仍會害你送命。<02><00>"
  },
  {
    "key": "f87a66bbb0f044f3",
    "location": "X5BTL101.BIN:08:5B",
    "zh": "<00>想要變強，<03>就一次對付一個敵人，<03>並從錯誤中學習。<02><00>"
  },
  {
    "key": "815bd6a84201329f",
    "location": "X5BTL101.BIN:08:5C",
    "zh": "<00>偉大的戰士不是天生的。<03>想要變強，<03>就得累積經驗。<02><00>"
  },
  {
    "key": "5600ff06bd93fce7",
    "location": "X5BTL101.BIN:08:5D",
    "zh": "<00><11><01>大人，真正的戰士懂得<03>何時進攻，何時耐心等待。<02><00>"
  },
  {
    "key": "6c928c74ce95cfbc",
    "location": "X5BTL99.BIN:08:50",
    "zh": "<00>先讓你稍微體驗一下……<05><03>擊敗所有敵人即可前進。<03>不能讓 <10> 被打倒。<02><00>"
  },
  {
    "key": "3a714e632418ab10",
    "location": "X5BTL99.BIN:08:51",
    "zh": "<00>隊長不能往那裡走！<02><00>"
  },
  {
    "key": "4bf84b5421759c47",
    "location": "X5BTL99.BIN:08:52",
    "zh": "<00><1A> 是我的救命恩人。<02><00>"
  }
]
